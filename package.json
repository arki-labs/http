{
  "name": "@arki/http",
  "version": "0.5.0",
  "description": "Typed HTTP for ARKI — route contracts as data, schema-validated handlers (any Standard Schema), request-scope derivers, SSE streaming, OpenAPI generation, and the DOT http() plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "http",
    "hono",
    "sse",
    "streaming",
    "openapi",
    "dot"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dot": {
      "types": "./dist/dot.d.ts",
      "import": "./dist/dot.js",
      "default": "./dist/dot.js"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "import": "./dist/projection.js",
      "default": "./dist/projection.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./idempotency": {
      "types": "./dist/idempotency.d.ts",
      "import": "./dist/idempotency.js",
      "default": "./dist/idempotency.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "default": "./dist/webhooks.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "default": "./dist/context.js"
    },
    "./package.json": "./package.json",
    "./public-fetch": {
      "types": "./dist/public-fetch.d.ts",
      "import": "./dist/public-fetch.js",
      "default": "./dist/public-fetch.js"
    }
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "README.md",
    "docs/**",
    "!docs/examples/*.test.ts",
    "!docs/examples/tsconfig.json",
    "llms.txt",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@arki/contracts": "0.4.2",
    "@arki/failure": "0.4.0",
    "@arki/log": "0.4.1",
    "@arki/resilience": "0.3.3",
    "@arki/schema": "0.3.1",
    "@hono/node-server": "^2.1.4",
    "@opentelemetry/api": "^1.9.1",
    "hono": "^4.13.13",
    "ipaddr.js": "^2.5.0",
    "undici": "^8.11.2",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@arki/dot": "^0.11.0"
  },
  "peerDependenciesMeta": {
    "@arki/dot": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "arki": {
    "runtimes": [
      "node",
      "bun",
      "deno",
      "browser",
      "hermes"
    ]
  }
}
